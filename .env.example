# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string for production persistence.
# When omitted in local development, the Express server uses server/data/store.json.
MONGODB_URI=

# ADMIN_PASSCODE: Passcode for the Studio Admin console.
# Leave unset on first boot to claim an initial passcode directly in the Admin tab.
ADMIN_PASSCODE=
